# EcoPick email delivery
# Keep .env local and never commit real credentials.
MAIL_ENABLED=false
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=EcoPick
MAIL_SUBJECT_PREFIX=[EcoPick]

# SMTP values are kept here for the configured PHP mail transport or a future SMTP adapter.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
